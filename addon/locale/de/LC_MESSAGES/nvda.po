#. Translators: Message presented in input help mode.
#: addon\appModules\eMule.py:49
msgid "Reads the specified column for the current list item."
msgstr "Liest die angegebene Spalte für das aktuelle Listenelement."

#. Translators: Message presented in input help mode.
#: addon\appModules\eMule.py:61
msgid "Copies the last read column of the selected list item to clipboard."
msgstr "Kopiert die letzte Lesespalte des ausgewählten Listenelements in die Zwischenablage."

#. Translators: Message presented when the current column of the list item is copied to clipboard.
#: addon\appModules\eMule.py:76
#, python-format
msgid "%s copied to clipboard"
msgstr "%s in die Zwischenablage kopiert."

#. Translators: Message presented in input help mode.
#: addon\appModules\eMule.py:177
msgid "Moves the system focus and mouse to the main Tool Bar."
msgstr "Bewegt den System-Fokus und die Maus auf die Hauptsymbolleiste."

#. Translators: Message presented in input help mode.
#. For instance: reads the search window, Statistics, IRC, etc.
#: addon\appModules\eMule.py:193
msgid "Reports the current window."
msgstr "Liest das aktuelle Fenster vor."

#. Translators: Message presented in input help mode.
#: addon\appModules\eMule.py:205
msgid "Moves the system focus to the Name field of the Search window."
msgstr "Bewegt den System-Fokus in das Suchfeld des Fensters."

#. Translators: Message presented in input help mode.
#: addon\appModules\eMule.py:229
msgid "Moves the system focus and mouse to the search parameters list or Edit field for each option, in the Search window."
msgstr "Bewegt den System-Fokus und die Maus auf die Liste der Suchparameter oder das Feld Bearbeiten für jede Option im Suchfenster."

#. Translators: Message presented in input help mode.
#: addon\appModules\eMule.py:257
msgid "Moves the system focus to the first list in the current window. For example the results list in the Search window, downloads in Transfer, etc."
msgstr "Bewegt den System-Fokus auf die erste Liste im aktuellen Fenster. Zum Beispiel die Ergebnisliste im Suchfenster, Downloads im Transfer, etc."

#. Translators: Message presented in input help mode.
#: addon\appModules\eMule.py:283
msgid "Moves the system focus to read-only edit boxes in the current window. For example the IRC received messages."
msgstr "Bewegt den System-Fokus auf schreibgeschützte Eingabefelder im aktuellen Fenster. Zum Beispiel hat der IRC Nachrichten empfangen."

#. Translators: Message presented in input help mode.
#: addon\appModules\eMule.py:314
msgid "Moves the navigator object and mouse to the current list headers."
msgstr "Bewegt das Navigat-Orobjekt und die Maus auf die aktuellen Listenüberschriften."

#. Translators: Message presented in input help mode.
#: addon\appModules\eMule.py:328
msgid "Reports first object of the Status Bar."
msgstr "Liest das erste Objekt der Statusleiste vor."

#. Translators: Message presented in input help mode.
#: addon\appModules\eMule.py:338
msgid "Reports second object of the Status Bar."
msgstr "Liest das zweite Objekt der Statusleiste vor."

#. Translators: Message presented in input help mode.
#: addon\appModules\eMule.py:348
msgid "Reports third object of the Status Bar."
msgstr "Liest das dritte Objekt der Statusleiste vor."

#. Translators: Message presented in input help mode.
#: addon\appModules\eMule.py:358
msgid "Reports fourth object of the Status Bar."
msgstr "Liest das vierte Objekt der Statusleiste vor."

#. Translators: Message resented in input help mode.
#: addon\appModules\eMule.py:368
msgid "Toggles on and off the usage of an alternative approach to read sliders"
msgstr ""

#. Translators: Reported when usage of alternative approach for slides is on.
#: addon\appModules\eMule.py:376
msgid "Use alternative approach to read slides on"
msgstr ""

#. Translators: Reported when usage of alternative approach for slides is off.
#: addon\appModules\eMule.py:378
msgid "Use alternative approach to read slides off"
msgstr ""

#. Add-on summary/title, usually the user visible name of the add-on
#. Translators: Summary/title for this add-on
#. to be shown on installation and add-on information found in add-on store
#: buildVars.py:20
msgid "eMule"
msgstr "eMule"

#. Add-on description
#. Translators: Long description to be shown for this add-on on add-on information from add-on store
#: buildVars.py:23
msgid "Improves eMule's accessibility with NVDA.\n"
"eMule is a P2P program to search and share files.\n"
"You can get more information about eMule at\n"
"http://www.emule-project.net"
msgstr "Verbessert die Zugänglichkeit von eMule mit NVDA.\n"
"eMule ist ein P2P-Programm zum Suchen und Teilen von Dateien.\n"
"Weitere Informationen zu eMule finden Sie unter https://www.emule-project.net.."

